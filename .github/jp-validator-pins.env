# JP FHIR Validator Bridge — pin file (P2-13 PR3 sub-PR-C 高度化, session 48)
#
# validator_cli.jar / JP IG packages のバージョンと SHA256 を集約。
# `.github/workflows/jp-validate.yml` と `scripts/validate_jp.sh` が
# source して version-immutable な pinning を行う。
#
# **STRICT モード**(推奨、CI default):
#   すべての SHA256 が空でない → 実測 SHA256 と一致しないと fail。
#
# **BOOTSTRAP モード**(初期化 or version 昇格時のみ):
#   SHA256 空欄で validate_jp.sh を回し、`scripts/pin_jp_validator.sh` で
#   実測 SHA256 を printf → この env に書き戻し + commit。
#
# 更新手順:
#   1. VALIDATOR_VERSION を最新 stable release tag に上げる
#      (https://github.com/hapifhir/org.hl7.fhir.core/releases)
#   2. 該当 SHA256 を空欄化
#   3. `bash scripts/pin_jp_validator.sh` を実行
#   4. 出力される新 SHA256 を該当行に貼り付け + commit
#
# 参照:docs/jp-clins.md「JP FHIR Validator Bridge」節

# ─────────────────────────────────────────────────────────────
# HL7 官方 FHIR Validator CLI(hapifhir/org.hl7.fhir.core release)
# ─────────────────────────────────────────────────────────────
#
# Release URL パターン:
#   https://github.com/hapifhir/org.hl7.fhir.core/releases/download/<VERSION>/validator_cli.jar
#
# 空欄時:workflow は soft-mode で警告 + validation を実行(bootstrap 用)。
# 値ありのとき:workflow は strict-mode で sha256 mismatch → fail。
# Pinned 2026-11-10 (Issue #3123): 6.10.4 (2026-09-04), the last 6.x
# release; 6.4.3 failed against tx.fhir.org ("cache ... was never issued by
# this server"). SHA256 of the GitHub release asset validator_cli.jar
# (200,928,617 bytes), computed locally and equal to the digest GitHub
# publishes for the asset.
VALIDATOR_VERSION=6.10.4
VALIDATOR_SHA256=1106b9d58f9e363e47bea7c4fc065841e5fc91fe9d062775c3bfdd212bd653cc

# ─────────────────────────────────────────────────────────────
# JP IG packages(version pin)
# ─────────────────────────────────────────────────────────────
#
# 使い方:
#   *_PACKAGE_URL のみ → ダウンロードして SHA256 を検証し -ig <tgz>
#   *_PACKAGE_URL + *_PACKAGE_ID + *_PACKAGE_VERSION → ダウンロード・検証後、
#     validator の package cache に <id>#<version> として展開する
#     (IG が依存として宣言するが registry に無い package 用)
#   *_PACKAGE_ID + *_PACKAGE_VERSION のみ → -ig <id>#<version> (registry 解決)
#   すべて空 → validator の profile URL online 解決に fallback
#
# Issue #3123 (2026-11-10): JP-CLINS 1.13.0 と JP-eCheckup 1.7.0 はどの
# package registry (packages.fhir.org / packages2 / simplifier) にも無く、
# jpfhir.jp の tarball を直接 pin する。両者が依存として宣言する
# jp-core.r4#1.1.2-clins と jpfhir-terminology.r4#2.0.0 も registry に無い。
#   - jp-core.r4#1.1.2-clins: jpfhir.jp/fhir/core/1.1.2-clins の package
#     (package.json の name は jpfhir.jp.core、version 1.1.2-clins)
#   - jpfhir-terminology.r4#2.0.0: 2.0.0 は公開されていないため、公開中の
#     jpfhir-terminology 2.2606.0 をその id#version として展開する
#     (JP-CLINS の CodeSystem / ValueSet を収録した現行版)
# JP Core 1.1.7 (以前の pin) は registry に存在しない。
# SHA256 はすべて上記 URL から取得した tarball をローカルで計算した値。

JP_TERMINOLOGY_PACKAGE_ID=jpfhir-terminology.r4
JP_TERMINOLOGY_PACKAGE_VERSION=2.0.0
JP_TERMINOLOGY_PACKAGE_URL=https://jpfhir.jp/fhir/core/terminology/igv-2.2606.0/package.tgz
JP_TERMINOLOGY_PACKAGE_SHA256=831b1f6ce5c3d7712ea5d167cb371c87dbf3ea08e70f29267d80acd508becaff

JP_CORE_PACKAGE_ID=jp-core.r4
JP_CORE_PACKAGE_VERSION=1.1.2-clins
JP_CORE_PACKAGE_URL=https://jpfhir.jp/fhir/core/1.1.2-clins/package.tgz
JP_CORE_PACKAGE_SHA256=4f3600b2d99c65547e7e60396b919d9a36762bcc6400f49c7a90e1999b6c45fe

# JP-CLINS (eCS / eDischargeSummary / eReferral) 1.13.0
JP_CLINS_PACKAGE_ID=
JP_CLINS_PACKAGE_VERSION=
JP_CLINS_PACKAGE_URL=https://jpfhir.jp/fhir/clins/igv1.13.0/package.tgz
JP_CLINS_PACKAGE_SHA256=37ac6859086a16d276fabfb43616d127d40e326d78ceaf03a977705cc9c9a1cc

# JP-eCheckup 1.7.0
JP_ECHECKUP_PACKAGE_ID=
JP_ECHECKUP_PACKAGE_VERSION=
JP_ECHECKUP_PACKAGE_URL=https://jpfhir.jp/fhir/eCheckup/igv170/package.tgz
JP_ECHECKUP_PACKAGE_SHA256=c4f9e3a302f817279f21ecf8d9a9302502df430660f94ba2c7e39a55ef3dba4a
