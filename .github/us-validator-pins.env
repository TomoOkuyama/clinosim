# US FHIR Validator Bridge — pin file (S115, Issue #1418 Phase 3)
#
# validator_cli.jar / US Core IG package のバージョンと SHA256 を集約。
# `.github/workflows/us-validate.yml` と `scripts/validate_us.sh` が
# source して version-immutable な pinning を行う。
#
# **STRICT モード**(推奨、CI default):
#   すべての SHA256 が空でない → 実測 SHA256 と一致しないと fail。
#
# **BOOTSTRAP モード**(初期化 or version 昇格時のみ):
#   SHA256 空欄で validate_us.sh を回し、`scripts/pin_us_validator.sh` で
#   実測 SHA256 を printf → この env に書き戻し + commit。
#
# 更新手順:
#   1. VALIDATOR_VERSION を最新 stable release tag に上げる
#      (https://github.com/hapifhir/org.hl7.fhir.core/releases)
#   2. 該当 SHA256 を空欄化
#   3. `bash scripts/pin_us_validator.sh` を実行
#   4. 出力される新 SHA256 を該当行に貼り付け + commit
#
# JP 側 (`.github/jp-validator-pins.env`) と同じ validator_cli.jar
# を使うが、JP と独立に pin 管理して片方のみの upgrade を可能にする。

# ─────────────────────────────────────────────────────────────
# HL7 官方 FHIR Validator CLI(hapifhir/org.hl7.fhir.core release)
# ─────────────────────────────────────────────────────────────
#
# Release URL パターン:
#   https://github.com/hapifhir/org.hl7.fhir.core/releases/download/<VERSION>/validator_cli.jar
#
# 空欄時:workflow は soft-mode で警告 + validation を実行(bootstrap 用)。
# 値ありのとき:workflow は strict-mode で sha256 mismatch → fail。
VALIDATOR_VERSION=6.4.3
VALIDATOR_SHA256=

# ─────────────────────────────────────────────────────────────
# US Core IG package(version pin)
# ─────────────────────────────────────────────────────────────
#
# validator は `-ig <id>#<version>` 形式で packages.fhir.org から
# package.tgz を取得する (NPM-style FHIR package registry)。
# US Core は packages.fhir.org に安定版がある (id=hl7.fhir.us.core)。
# STU8 (8.0.0) が 2024 release の latest stable。
#
# 使い方:
#   *_PACKAGE_ID + *_PACKAGE_VERSION 両方指定 → -ig <id>#<version>
#   *_PACKAGE_URL 指定 → -ig <ローカルにダウンロードした .tgz path>
#   両方空 → validator の profile URL online 解決に fallback

US_CORE_PACKAGE_ID=hl7.fhir.us.core
US_CORE_PACKAGE_VERSION=8.0.0
US_CORE_PACKAGE_URL=
US_CORE_PACKAGE_SHA256=
